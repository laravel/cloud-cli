{
    "name": "laravel/cloud-cli",
    "description": "CLI to interact with Laravel Cloud",
    "keywords": [
        "laravel",
        "cloud",
        "cli"
    ],
    "homepage": "https://cloud.laravel.com",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laravel/cloud-cli/issues",
        "source": "https://github.com/laravel/cloud-cli"
    },
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "illuminate/http": "^13.0",
        "illuminate/translation": "^13.0",
        "illuminate/validation": "^13.0",
        "laravel-zero/framework": "^13.0",
        "laravel-zero/phar-updater": "^1.4",
        "laravel/agent-detector": "^2.0",
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2",
        "php-parallel-lint/php-console-highlighter": "^1.0",
        "phpstan/phpstan": "^2.1",
        "saloonphp/cache-plugin": "^3.1",
        "saloonphp/pagination-plugin": "^2.3",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-data": "^4.19"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "builds/cloud"
    ]
}
