<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>./tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>./tests/Unit</directory>
        </testsuite>
    </testsuites>
    <php>
        <!--
            The CLI picks interactive or headless behaviour from the environment (TTY, CI and
            agent env vars). The suite expects headless, which CI and agents provide but a
            developer's own terminal doesn't, so pin it to match CI.

            NO_COLOR matters because decorated (TTY) output makes Laravel Prompts' spinner fork
            a child process, which can outlive the test and signal the test runner.
        -->
        <env name="CI" value="true" force="true"/>
        <env name="NO_COLOR" value="1" force="true"/>
    </php>
    <source>
        <include>
            <directory>./app</directory>
        </include>
    </source>
</phpunit>
